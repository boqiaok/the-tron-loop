NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ADMIN_COOKIE_SECURE=false
IMPORTS_ENABLED=false
EVENTFINDA_USERNAME=
EVENTFINDA_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

DATABASE_URL=postgres://tron_loop:tron_loop_dev@localhost:5432/the_tron_loop

# Cloudflare R2 bucket for uploaded images. Local development uses the
# whson-media-dev bucket and its public r2.dev URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whson-media-dev
MEDIA_PUBLIC_URL=https://pub-<id>.r2.dev
